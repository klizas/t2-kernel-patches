From: klizas <lukas@klizas.lt>
Subject: [PATCH] power: supply: macsmc: report the design capacity on T2

The ACPI (T2) battery lists no CHARGE_FULL_DESIGN or ENERGY_FULL_DESIGN,
so upower shows energy-full-design 0 Wh and nothing can compute battery
health. Apple Silicon already reads both from B0DC.

T2 has B0DC too. Like B0TE it is little-endian although most T2 keys
are big-endian, so it needs no swab16() where B0FC does. On a
MacBookPro16,1 it reads 8700 mAh, the charge_full_design ACPI SBS
reported for the same battery on 7.2.

List both properties on ACPI when B0DC exists. ACPI has no
nominal_voltage_mv, and ENERGY_FULL there is B0FC times B0AV, so compute
ENERGY_FULL_DESIGN with B0AV as well. energy_full / energy_full_design
then equals charge_full / charge_full_design, whichever pair a reader
divides.

--- a/drivers/power/supply/macsmc-power.c
+++ b/drivers/power/supply/macsmc-power.c
@@ -702,6 +702,7 @@
 		}
 		break;
 	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
+		/* B0DC is little-endian on T2 too, unlike B0FC */
 		ret = apple_smc_read_u16(power->smc, SMC_KEY(B0DC), &vu16);
 		val->intval = vu16 * 1000;
 		break;
@@ -721,7 +722,17 @@
 		break;
 	case POWER_SUPPLY_PROP_ENERGY_FULL_DESIGN:
 		ret = apple_smc_read_u16(power->smc, SMC_KEY(B0DC), &vu16);
-		val->intval = vu16 * power->nominal_voltage_mv;
+		if (power->smc->is_acpi) {
+			if (ret < 0)
+				return ret;
+
+			u16 voltage;
+
+			/* The voltage ENERGY_FULL uses, so both share one scale */
+			ret = apple_smc_read_u16(power->smc, SMC_KEY(B0AV), &voltage);
+			val->intval = vu16 * swab16(voltage);
+		} else
+			val->intval = vu16 * power->nominal_voltage_mv;
 		break;
 	case POWER_SUPPLY_PROP_ENERGY_FULL:
 		ret = apple_smc_read_u16(power->smc, SMC_KEY(B0FC), &vu16);
@@ -1114,6 +1125,10 @@
 				props[nprops++] = POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN;
 			if (apple_smc_key_exists(smc, SMC_KEY(BCMV)))
 				props[nprops++] = POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN;
+			if (apple_smc_key_exists(smc, SMC_KEY(B0DC))) {
+				props[nprops++] = POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN;
+				props[nprops++] = POWER_SUPPLY_PROP_ENERGY_FULL_DESIGN;
+			}
 
 			if (apple_smc_key_exists(smc, SMC_KEY(BC3V)))
 				power->num_cells = 3;
